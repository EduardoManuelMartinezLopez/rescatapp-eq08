# Copia este archivo como ".env" y llena tus valores. NUNCA subas ".env" a GitHub.
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rescatapp
DB_USER=postgres
DB_PASSWORD=pon_aqui_tu_password_de_postgres
# Secreto para firmar los tokens JWT (cámbialo por una cadena larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_secreta
JWT_EXPIRES=8h
# Dirección del frontend (para CORS y para los enlaces de los correos)
FRONTEND_URL=http://localhost:5173

# --- Recuperar contraseña ---
# En desarrollo: si es "true", la API devuelve el enlace de recuperación (y lo imprime en la terminal).
# En producción debe ser "false" y configurarse el correo (SMTP).
DEV_SHOW_RESET_LINK=true
# Correo real (opcional). Ejemplo Gmail: host smtp.gmail.com, puerto 465, usuario = tu correo, contraseña = "contraseña de aplicación"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=RescatApp <no-responder@rescatapp.test>

# --- Iniciar sesión con Google (opcional) ---
# ID de cliente de OAuth creado en Google Cloud Console (termina en .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=
